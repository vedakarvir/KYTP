{
  "name": "gst-payment-platform",
  "version": "0.1.0",
  "description": "POC: GST-compliant payment platform for India with receipt scanning, UPI payments, and GST compliance",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --detectOpenHandles",
    "test:ocr": "node tests/test-ocr.js",
    "test:payment": "node tests/test-payment.js",
    "test:gst": "node tests/test-gst.js",
    "db:migrate": "psql $DATABASE_URL -f database/schema.sql",
    "db:seed": "node database/seed.js",
    "db:backup": "bash scripts/backup-db.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docs": "swagger-ui-express -p 8080",
    "perf": "clinic doctor -- node server.js"
  },
  "keywords": [
    "GST",
    "India",
    "Payment",
    "UPI",
    "Tax",
    "Compliance",
    "OCR",
    "Receipt"
  ],
  "author": "Your Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.0.3",
    "pg": "^8.10.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "@google-cloud/vision": "^3.5.0",
    "axios": "^1.4.0",
    "xml2js": "^0.6.2",
    "express-validator": "^7.0.0",
    "redis": "^4.6.0",
    "joi": "^17.9.2",
    "moment": "^2.29.4",
    "uuid": "^9.0.0",
    "pino": "^8.11.0",
    "pino-http": "^8.3.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.6.0",
    "supertest": "^6.3.3",
    "eslint": "^8.41.0",
    "prettier": "^2.8.8",
    "swagger-ui-express": "^4.6.1",
    "swagger-jsdoc": "^6.2.8",
    "clinic": "^13.0.0",
    "@faker-js/faker": "^8.0.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/gst-payment-platform.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/gst-payment-platform/issues"
  },
  "homepage": "https://github.com/your-org/gst-payment-platform#readme"
}
